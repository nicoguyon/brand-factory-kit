# Copie ce fichier en keys.env (dans ton dossier de marque) ou en ~/.brand_factory/keys.env, puis remplis.
# Ne partage jamais keys.env.

# INDISPENSABLE : images (directions, produits, visuels, essayage). aistudio.google.com › Get API key
GEMINI_API_KEY=

# Logos avec texte lisible (GPT Image 2.5) et film Kling 3.0. fal.ai › Dashboard › Keys
FAL_KEY=

# Styliste de la cabine d'essayage (Jev). console.typesafe.ai › Keys (5 $ offerts)
TYPESAFE_API_KEY=

# Musique du film. sunoapi.org › API Key
SUNO_API_KEY=

# Voix off du film. elevenlabs.io › Profile › API Key
ELEVENLABS_API_KEY=
